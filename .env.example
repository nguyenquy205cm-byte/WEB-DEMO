# ──────────────────────────────────────────────
# WEB-DEMO — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── MySQL ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ── Redis ──────────────────────────────────────
REDIS_PASSWORD=

# ── Backend ─────────────────────────────────────
# JWT secret — use a long random string in production!
JWT_SECRET=

# ── Azure Storage (optional, leave blank to use local disk) ──
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
